generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id        String   @id @default(uuid())
  course    String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  members       TeamMember[]
  levelProgress LevelProgress[]
  attempts      Attempt[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("team_members")
}

model Level {
  id         Int     @id
  name       String  @db.VarChar(100)
  difficulty String? @db.VarChar(50)
  isActive   Boolean @default(true) @map("is_active")

  levelProgress LevelProgress[]
  attempts      Attempt[]

  @@map("levels")
}

model LevelProgress {
  id                 String    @id @default(uuid())
  teamId             String    @map("team_id")
  levelId            Int       @map("level_id")
  unlocked           Boolean   @default(false)
  completed          Boolean   @default(false)
  bestMoves          Int?      @map("best_moves")
  bestTimeSeconds    Int?      @map("best_time_seconds")
  bestLivesRemaining Int?      @map("best_lives_remaining")
  completedAt        DateTime? @map("completed_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id])

  @@unique([teamId, levelId])
  @@index([teamId])
  @@map("level_progress")
}

model Attempt {
  id                 String    @id @default(uuid())
  teamId             String    @map("team_id")
  levelId            Int       @map("level_id")
  movesCount         Int       @default(0) @map("moves_count")
  durationSeconds    Int?      @map("duration_seconds")
  livesRemaining     Int       @default(5) @map("lives_remaining")
  activeCheckpointId Int?      @map("active_checkpoint_id")
  status             String    @db.VarChar(30)
  startedAt          DateTime  @default(now()) @map("started_at")
  endedAt            DateTime? @map("ended_at")

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id])

  @@index([teamId])
  @@index([levelId])
  @@index([status])
  @@map("attempts")
}
